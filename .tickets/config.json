{
  "backend": "github",
  "github": {
    "owner": "morodomi",
    "repo": "ait3",
    "useGhCli": true,
    "labels": {
      "todo": "status:todo",
      "doing": "status:doing",
      "done": "status:done"
    }
  },
  "path": ".tickets",
  "numbering": {
    "format": "0000",
    "increment": 1,
    "next": 41
  },
  "templates": {
    "feature": "templates/feature-ticket.md",
    "bug": "templates/bug-ticket.md",
    "task": "templates/task-ticket.md"
  },
  "labels": {
    "priority": [
      "low",
      "medium",
      "high",
      "critical"
    ],
    "type": [
      "feature",
      "bug",
      "task",
      "spike"
    ],
    "status": [
      "todo",
      "doing",
      "done"
    ]
  }
}