{
  "name": "@morodomi/ait3",
  "version": "1.1.0-dev",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "ait3": "./bin/ait3.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run",
    "coverage": "vitest run --coverage",
